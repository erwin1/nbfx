<?xml version="1.0" encoding="UTF-8"?>
<!--
  nbfx build harness.

  Hosts the pure-JavaFX nbfx clusters and consumes apache/netbeans as a git
  submodule, applying a small patch set (friend declarations + build/packaging
  hooks) and generating an own cluster configuration from the submodule's
  nbbuild/cluster.properties.

  Everything is Ant so the build works on macOS, Linux and Windows.

  Typical use:
      ant bootstrap      # submodule + patches + cluster config + overlay
      ant build          # build the nbfx cluster config
      ant run            # launch the FX app on the lean cluster set
      ant check-purity   # guardrails
      ant update-upstream -Dnbfx.submodule.commit=<sha>
      ant clean
-->
<project name="nbfx" default="help" basedir="." xmlns:if="ant:if" xmlns:unless="ant:unless">

    <!-- local overrides first: Ant keeps the first value a property gets -->
    <property file="nbfx-local.properties"/>
    <property file="nbfx.properties"/>
    <property name="nbfx.javafx.module" location="nbfx-libs/c.gluonhq.netbeans.nbfx.libs.javafx"/>
    <property file="${nbfx.javafx.module}/javafx-sdk.properties"/>

    <!-- ==== derived properties ==== -->
    <property name="nbfx.sub.dir" location="${nbfx.submodule.dir}"/>
    <property name="nbfx.patches.dir" location="patches"/>
    <property name="nbfx.fragment" location="${nbfx.fragment.file}"/>
    <property name="nbfx.cluster.file" location="${nbfx.cluster.properties}"/>
    <property name="nbfx.patch.stamp" location="${nbfx.build.dir}/patches-${nbfx.submodule.commit}.stamp"/>

    <condition property="nbfx.os.windows">
        <os family="windows"/>
    </condition>
    <condition property="nbfx.overlay.symlink">
        <equals arg1="${nbfx.overlay}" arg2="symlink"/>
    </condition>
    <!-- the JavaFX SDK `ant bootstrap` puts into libs.javafx: the build machine's platform, unless
         -Dnbfx.javafx.platform=<id> (an id of javafx-sdk.properties) says otherwise -->
    <condition property="nbfx.javafx.platform" value="macos-aarch64">
        <and><os family="mac"/><os arch="aarch64"/></and>
    </condition>
    <condition property="nbfx.javafx.platform" value="macos-x64">
        <and><os family="mac"/><os arch="x86_64"/></and>
    </condition>
    <condition property="nbfx.javafx.platform" value="windows-x64">
        <and><os family="windows"/><os arch="amd64"/></and>
    </condition>
    <condition property="nbfx.javafx.platform" value="linux-x64">
        <and><os name="Linux"/><os arch="amd64"/></and>
    </condition>
    <!-- the downloaded SDK zips; the same cache the NetBeans build keeps its binaries in, so they
         survive `ant clean` and CI's cache of it covers them -->
    <property name="nbfx.download.cache" location="${user.home}/.hgexternalcache"/>

    <!-- release targets: rat, release-src, release-bin, release-sign, release-verify, release -->
    <import file="release/release.xml"/>

    <!-- list of the cluster dirs, also as ${nbfx.cluster.1}..${nbfx.cluster.N} is not
         available in plain Ant, so the macros below are invoked explicitly. -->

    <!-- ======================================================================== -->
    <!-- macros                                                                   -->
    <!-- ======================================================================== -->

    <macrodef name="nbfx-overlay-sync-one">
        <attribute name="cluster"/>
        <sequential>
            <sync todir="${nbfx.sub.dir}/@{cluster}" includeEmptyDirs="false">
                <!-- only exclude the per-module output dirs (<module>/build, <module>/dist);
                     a bare **/build/** would also drop source packages named ".../build/..." -->
                <fileset dir="@{cluster}" excludes="*/build/**,*/dist/**"/>
                <!-- keep the output of earlier per-module builds (`ant module`) so they stay incremental -->
                <preserveintarget>
                    <include name="*/build/**"/>
                    <include name="*/dist/**"/>
                </preserveintarget>
            </sync>
        </sequential>
    </macrodef>

    <macrodef name="nbfx-unoverlay-one">
        <attribute name="cluster"/>
        <sequential>
            <!-- removes the overlay whether it is a synced copy or a symlink; safe for
                 symlinks because git clean unlinks the link, not the target -->
            <exec executable="git" dir="${nbfx.sub.dir}" failonerror="false">
                <arg value="clean"/>
                <arg value="-Xdff"/>
                <arg value="--"/>
                <arg value="@{cluster}"/>
            </exec>
        </sequential>
    </macrodef>

    <macrodef name="nbfx-overlay-symlink-one">
        <attribute name="cluster"/>
        <sequential>
            <!-- a previous sync overlay is a directory: remove it (nbfx-unoverlay-one), then an
                 old link if any; <delete file> alone cannot remove a directory -->
            <nbfx-unoverlay-one cluster="@{cluster}"/>
            <delete file="${nbfx.sub.dir}/@{cluster}" quiet="true"/>
            <symlink link="${nbfx.sub.dir}/@{cluster}"
                     resource="${basedir}/@{cluster}" overwrite="true"/>
        </sequential>
    </macrodef>

    <!-- Unpacks the OpenJFX SDK of @{platform} (javafx-sdk.properties) into @{dest} in the layout of
         libs.javafx's release dir: modules/ext/*.jar, the natives flat in modules/lib/, the licence
         texts in legal/javafx/. Only the modules nbfx bundles: no javafx.web/WebKit, media, swing or
         swt (Appendix G). Skipped when @{stamp} records the same platform and SDK already. -->
    <macrodef name="nbfx-javafx-unpack">
        <attribute name="platform"/>
        <attribute name="dest"/>
        <attribute name="stamp"/>
        <sequential>
            <fail message="Unknown JavaFX platform '@{platform}'; use one of the ids in ${nbfx.javafx.module}/javafx-sdk.properties (-Dnbfx.javafx.platform=...)">
                <condition>
                    <not><isset property="nbfx.javafx.sha256.@{platform}"/></not>
                </condition>
            </fail>
            <local name="sdk.name"/>
            <local name="sdk.file"/>
            <local name="sdk.ok"/>
            <local name="stamp.text"/>
            <local name="stamp.current"/>
            <property name="sdk.name" value="openjfx-${nbfx.javafx.version}_${nbfx.javafx.sdk.@{platform}}_bin-sdk.zip"/>
            <!-- named after its checksum, as the NetBeans build names its downloads: a re-pin never
                 reuses a stale file -->
            <property name="sdk.file" location="${nbfx.download.cache}/${nbfx.javafx.sha256.@{platform}}-${sdk.name}"/>
            <loadfile property="stamp.text" srcFile="@{stamp}" failonerror="false" quiet="true"/>
            <condition property="stamp.current">
                <and>
                    <equals arg1="${stamp.text}" arg2="@{platform} ${nbfx.javafx.sha256.@{platform}}" trim="true"/>
                    <available file="@{dest}/modules/ext/javafx.graphics.jar"/>
                </and>
            </condition>
            <sequential unless:set="stamp.current">
                <mkdir dir="${nbfx.download.cache}"/>
                <get src="${nbfx.javafx.url}/${sdk.name}" dest="${sdk.file}" skipexisting="true"/>
                <checksum file="${sdk.file}" algorithm="SHA-256" property="${nbfx.javafx.sha256.@{platform}}" verifyproperty="sdk.ok"/>
                <fail message="${sdk.file} does not match nbfx.javafx.sha256.@{platform}; delete it and retry">
                    <condition><isfalse value="${sdk.ok}"/></condition>
                </fail>
                <delete dir="@{dest}/modules/ext"/>
                <delete dir="@{dest}/modules/lib"/>
                <delete dir="@{dest}/legal/javafx"/>
                <unzip src="${sdk.file}" dest="@{dest}/modules/ext">
                    <patternset includes="*/lib/javafx.base.jar,*/lib/javafx.controls.jar,*/lib/javafx.fxml.jar,*/lib/javafx.graphics.jar,*/lib/jfx.incubator.input.jar,*/lib/jfx.incubator.richtext.jar"/>
                    <flattenmapper/>
                </unzip>
                <!-- natives: lib/ on macOS and Linux, bin/ on Windows (with its MSVC/UCRT runtime) -->
                <unzip src="${sdk.file}" dest="@{dest}/modules/lib">
                    <patternset includes="*/lib/*.dylib,*/lib/*.so,*/bin/*.dll"
                                excludes="**/*jfxwebkit*,**/*jfxmedia*,**/*gstreamer*,**/*glib-lite*,**/*fxplugins*,**/*avplugin*"/>
                    <flattenmapper/>
                </unzip>
                <!-- the texts of the bundled modules; LICENSE, ADDITIONAL_LICENSE_INFO and
                     ASSEMBLY_EXCEPTION are the same file in each, so flattening is safe -->
                <unzip src="${sdk.file}" dest="@{dest}/legal/javafx">
                    <patternset includes="*/legal/javafx.base/*,*/legal/javafx.controls/*,*/legal/javafx.fxml/*,*/legal/javafx.graphics/*,*/legal/jfx.incubator.input/*,*/legal/jfx.incubator.richtext/*"/>
                    <flattenmapper/>
                </unzip>
                <!-- unzip keeps the SDK's dates, older than any earlier build's copies; the harness
                     copies release/ by date, so make them new or a platform switch would not reach
                     the cluster -->
                <touch>
                    <fileset dir="@{dest}" includes="modules/ext/**,modules/lib/**,legal/javafx/**"/>
                </touch>
                <echo file="@{stamp}" message="@{platform} ${nbfx.javafx.sha256.@{platform}}"/>
                <echo message="[nbfx] JavaFX ${nbfx.javafx.version} @{platform} -> @{dest}"/>
            </sequential>
        </sequential>
    </macrodef>

    <!-- ======================================================================== -->
    <!-- submodule                                                                -->
    <!-- ======================================================================== -->

    <target name="-submodule-present">
        <condition property="nbfx.submodule.present">
            <available file="${nbfx.sub.dir}/.git"/>
        </condition>
        <!-- a source release (git archive) has no .git: the pinned revision is fetched instead -->
        <condition property="nbfx.submodule.fetch">
            <and>
                <not><isset property="nbfx.submodule.present"/></not>
                <not><available file="${basedir}/.git"/></not>
            </and>
        </condition>
    </target>

    <target name="-submodule-init" depends="-submodule-present,-submodule-fetch" unless="nbfx.submodule.present">
        <exec executable="git" dir="${basedir}" failonerror="true">
            <arg value="submodule"/>
            <arg value="update"/>
            <arg value="--init"/>
        </exec>
    </target>

    <target name="-submodule-fetch" if="nbfx.submodule.fetch">
        <echo message="[nbfx] no git checkout: fetching ${nbfx.submodule.url} @ ${nbfx.submodule.commit}"/>
        <!-- fetched into a temporary dir that only replaces ${nbfx.sub.dir} when complete: a failed
             fetch must not leave a .git behind, or later runs would take it for a checkout -->
        <property name="nbfx.sub.fetch.dir" location="${nbfx.sub.dir}.fetch"/>
        <delete dir="${nbfx.sub.fetch.dir}" quiet="true"/>
        <mkdir dir="${nbfx.sub.fetch.dir}"/>
        <exec executable="git" dir="${nbfx.sub.fetch.dir}" failonerror="true">
            <arg line="init --quiet"/>
        </exec>
        <exec executable="git" dir="${nbfx.sub.fetch.dir}" failonerror="true">
            <arg line="fetch --quiet --depth 1 ${nbfx.submodule.url} ${nbfx.submodule.commit}"/>
        </exec>
        <exec executable="git" dir="${nbfx.sub.fetch.dir}" failonerror="true">
            <arg line="checkout --quiet FETCH_HEAD"/>
        </exec>
        <!-- the source release has an empty netbeans/ (the gitlink) -->
        <delete dir="${nbfx.sub.dir}"/>
        <move file="${nbfx.sub.fetch.dir}" tofile="${nbfx.sub.dir}"/>
        <property name="nbfx.submodule.present" value="true"/>
    </target>

    <target name="submodule" depends="-submodule-init"
            description="Check out the pinned netbeans revision (initialises the submodule if needed)">
        <exec executable="git" dir="${nbfx.sub.dir}" failonerror="true">
            <arg value="checkout"/>
            <arg value="--quiet"/>
            <arg value="${nbfx.submodule.commit}"/>
        </exec>
        <echo message="[nbfx] submodule ${nbfx.submodule.dir} @ ${nbfx.submodule.commit}"/>
    </target>

    <!-- ======================================================================== -->
    <!-- patches                                                                  -->
    <!-- ======================================================================== -->

    <target name="-patches-check-stamp">
        <condition property="patches.uptodate">
            <and>
                <available file="${nbfx.patch.stamp}"/>
                <not><isset property="force.patches"/></not>
            </and>
        </condition>
    </target>

    <target name="patches" depends="submodule,-patches-check-stamp,-patches-apply"
            description="Apply the upstream patch set (friend declarations + build hooks)"/>

    <target name="-patches-apply" unless="patches.uptodate">
        <mkdir dir="${nbfx.build.dir}"/>
        <echo message="[nbfx] applying ${nbfx.patches.dir}/*.patch to the submodule"/>
        <apply executable="git" dir="${nbfx.sub.dir}" failonerror="true" parallel="false">
            <arg value="apply"/>
            <arg value="--3way"/>
            <arg value="--whitespace=nowarn"/>
            <fileset dir="${nbfx.patches.dir}" includes="*.patch"/>
        </apply>
        <touch file="${nbfx.patch.stamp}"/>
    </target>

    <target name="patches-check" depends="submodule"
            description="Verify every patch still applies cleanly (used after an upstream bump)">
        <apply executable="git" dir="${nbfx.sub.dir}" failonerror="true" parallel="false">
            <arg value="apply"/>
            <arg value="--check"/>
            <arg value="--3way"/>
            <fileset dir="${nbfx.patches.dir}" includes="*.patch"/>
        </apply>
        <echo message="[nbfx] all patches apply cleanly"/>
    </target>

    <!-- ======================================================================== -->
    <!-- cluster configuration                                                    -->
    <!-- ======================================================================== -->

    <target name="-exclude-init">
        <!-- ${nbfx.cluster.exclude} (nbfx.properties) as two regex alternations: the module dir
             names as they appear in cluster.properties (dots escaped), and the same names with
             dots turned into dashes, which is how they end up in the built jar/config file names
             (org.netbeans.modules.core.kit -> org-netbeans-modules-core-kit.jar). -->
        <loadresource property="nbfx.cluster.exclude.re">
            <string value="${nbfx.cluster.exclude}"/>
            <filterchain>
                <tokenfilter>
                    <deletecharacters chars=" \t"/>
                    <replacestring from="." to="\."/>
                    <replacestring from="," to="|"/>
                </tokenfilter>
            </filterchain>
        </loadresource>
        <loadresource property="nbfx.cluster.exclude.dashed.re">
            <string value="${nbfx.cluster.exclude}"/>
            <filterchain>
                <tokenfilter>
                    <deletecharacters chars=" \t"/>
                    <replacestring from="." to="-"/>
                    <replacestring from="," to="|"/>
                </tokenfilter>
            </filterchain>
        </loadresource>
    </target>

    <target name="cluster-config" depends="submodule,-exclude-init"
            description="Generate the nbfx cluster configuration and install it into the submodule">
        <mkdir dir="${nbfx.build.dir}"/>
        <!-- The harness reads ${nb_all}/nbbuild/cluster.properties directly in several places
             (-define-cluster-path builds cluster.path from it; ModuleListParser scans the dirs of
             the clusters in clusters.config.full.list; packaging targets). An external
             -Dclusters.list.file is therefore not enough, so we install the generated file there.
             We always start from the pristine upstream file so re-runs are idempotent. -->
        <exec executable="git" dir="${nbfx.sub.dir}" failonerror="true">
            <arg value="checkout"/>
            <arg value="--"/>
            <arg value="nbbuild/cluster.properties"/>
        </exec>
        <loadfile property="nbfx.base.cluster" srcFile="${nbfx.sub.dir}/nbbuild/cluster.properties"/>
        <condition property="nbfx.base.token.found">
            <contains string="${nbfx.base.cluster}" substring="clusters.config.full.list=\"/>
        </condition>
        <fail unless="nbfx.base.token.found"
              message="clusters.config.full.list= not found in ${nbfx.sub.dir}/nbbuild/cluster.properties; upstream layout changed, update build.xml:cluster-config"/>
        <copy file="${nbfx.sub.dir}/nbbuild/cluster.properties" tofile="${nbfx.cluster.file}" overwrite="true"/>
        <!-- register the nbfx cluster dirs so ModuleListParser finds their modules -->
        <replace file="${nbfx.cluster.file}"
                 token="clusters.config.full.list=\"
                 value="clusters.config.full.list=\&#10;        nb.cluster.nbfx-libs,\&#10;        nb.cluster.nbfx-api,\&#10;        nb.cluster.nbfx-platform,\&#10;        nb.cluster.nbfx-ide,\&#10;        nb.cluster.nbfx-java,\"/>
        <!-- drop the modules listed in ${nbfx.cluster.exclude} (nbfx.properties) from the upstream
             cluster lists. The lists are backslash-continued, one "        name,\" per line, so an
             entry is removed together with its line ending; the last entry of a list has no
             trailing ",\" and is removed together with the continuation of the line before it. -->
        <replaceregexp file="${nbfx.cluster.file}" flags="gm"
                       match="^[ \t]*(?:${nbfx.cluster.exclude.re})[ \t]*,\\[ \t]*\r?\n" replace=""/>
        <replaceregexp file="${nbfx.cluster.file}" flags="gm"
                       match=",\\[ \t]*\r?\n[ \t]*(?:${nbfx.cluster.exclude.re})[ \t]*$" replace=""/>
        <!-- a single-entry list (validation.nb.cluster.ide=\ + ide.kit) becomes an empty one -->
        <replaceregexp file="${nbfx.cluster.file}" flags="gm"
                       match="=\\[ \t]*\r?\n[ \t]*(?:${nbfx.cluster.exclude.re})[ \t]*$" replace="="/>
        <concat destfile="${nbfx.cluster.file}" append="true" fixlastline="yes">
            <fileset file="${nbfx.fragment}"/>
        </concat>
        <!-- install it as the submodule's cluster.properties -->
        <copy file="${nbfx.cluster.file}" tofile="${nbfx.sub.dir}/nbbuild/cluster.properties" overwrite="true"/>
        <echo message="[nbfx] generated + installed ${nbfx.cluster.file} (cluster.config=${nbfx.cluster.config})"/>
    </target>

    <!-- ======================================================================== -->
    <!-- overlay                                                                  -->
    <!-- ======================================================================== -->

    <target name="-overlay-exclude" depends="submodule,-overlay-exclude-check,-overlay-exclude-append"/>

    <target name="-overlay-exclude-check">
        <exec executable="git" dir="${nbfx.sub.dir}" outputproperty="nbfx.sub.gitdir" failonerror="true">
            <arg value="rev-parse"/>
            <arg value="--absolute-git-dir"/>
        </exec>
        <mkdir dir="${nbfx.sub.gitdir}/info"/>
        <touch file="${nbfx.sub.gitdir}/info/exclude"/>
        <loadfile property="nbfx.sub.exclude" srcFile="${nbfx.sub.gitdir}/info/exclude" failonerror="false"/>
        <!-- the entries have no trailing slash: "nbfx-platform/" would match a directory only,
             not the symlink overlay (it then showed as untracked and git clean -X kept it) -->
        <condition property="nbfx.exclude.need">
            <not><matches string="${nbfx.sub.exclude}" pattern="(?m)^nbfx-libs$"/></not>
        </condition>
    </target>

    <target name="-overlay-exclude-append" if="nbfx.exclude.need">
        <echo file="${nbfx.sub.gitdir}/info/exclude" append="true">
nbfx-libs
nbfx-api
nbfx-platform
nbfx-ide
nbfx-java
</echo>
    </target>

    <target name="overlay" depends="submodule,-overlay-exclude,-overlay-sync,-overlay-symlink"
            description="Make the nbfx cluster dirs visible to the netbeans build (sync|symlink)"/>

    <target name="-overlay-sync" unless="nbfx.overlay.symlink">
        <!-- only a previous symlink overlay is removed first (sync cannot write through it);
             a previous sync copy is updated in place, keeping the per-module build output -->
        <symlink action="delete" link="${nbfx.sub.dir}/nbfx-libs" failonerror="false"/>
        <symlink action="delete" link="${nbfx.sub.dir}/nbfx-api" failonerror="false"/>
        <symlink action="delete" link="${nbfx.sub.dir}/nbfx-platform" failonerror="false"/>
        <symlink action="delete" link="${nbfx.sub.dir}/nbfx-ide" failonerror="false"/>
        <symlink action="delete" link="${nbfx.sub.dir}/nbfx-java" failonerror="false"/>
        <nbfx-overlay-sync-one cluster="nbfx-libs"/>
        <nbfx-overlay-sync-one cluster="nbfx-api"/>
        <nbfx-overlay-sync-one cluster="nbfx-platform"/>
        <nbfx-overlay-sync-one cluster="nbfx-ide"/>
        <nbfx-overlay-sync-one cluster="nbfx-java"/>
        <echo message="[nbfx] overlay=sync"/>
    </target>

    <target name="-overlay-symlink" if="nbfx.overlay.symlink">
        <nbfx-overlay-symlink-one cluster="nbfx-libs"/>
        <nbfx-overlay-symlink-one cluster="nbfx-api"/>
        <nbfx-overlay-symlink-one cluster="nbfx-platform"/>
        <nbfx-overlay-symlink-one cluster="nbfx-ide"/>
        <nbfx-overlay-symlink-one cluster="nbfx-java"/>
        <echo message="[nbfx] overlay=symlink"/>
    </target>

    <target name="unoverlay" depends="submodule"
            description="Remove the overlay from the submodule">
        <nbfx-unoverlay-one cluster="nbfx-libs"/>
        <nbfx-unoverlay-one cluster="nbfx-api"/>
        <nbfx-unoverlay-one cluster="nbfx-platform"/>
        <nbfx-unoverlay-one cluster="nbfx-ide"/>
        <nbfx-unoverlay-one cluster="nbfx-java"/>
    </target>

    <!-- ======================================================================== -->
    <!-- main targets                                                             -->
    <!-- ======================================================================== -->

    <target name="-prune-excluded" depends="submodule,-exclude-init"
            description="Remove previously built jars of modules excluded from the cluster config">
        <!-- Removing a module from the cluster config does not delete its previously built jar, and
             the launcher loads (and the release zips) every module present in a cluster dir. Prune
             the jar, branding jars, module status file and update tracking of every excluded module
             (${nbfx.cluster.exclude}) so a build dir from before the exclusion matches a clean one. -->
        <delete quiet="true" failonerror="false">
            <fileset dir="${nbfx.sub.dir}/nbbuild/netbeans" erroronmissingdir="false">
                <filename regex="^[^/\\]+[/\\](modules[/\\][^/\\]+-(?:${nbfx.cluster.exclude.dashed.re})\.jar|modules[/\\]locale[/\\][^/\\]+-(?:${nbfx.cluster.exclude.dashed.re})_[^/\\]+\.jar|config[/\\]Modules[/\\][^/\\]+-(?:${nbfx.cluster.exclude.dashed.re})\.xml|update_tracking[/\\][^/\\]+-(?:${nbfx.cluster.exclude.dashed.re})\.xml)$"/>
            </fileset>
        </delete>
    </target>

    <target name="-dist-launcher"
            description="Adjust the launcher of the built distribution (nbbuild/netbeans) for nbfx">
        <!-- upstream build-nozip re-copies bin/ and etc/ from nb/ide.launcher on every run, so this
             must run after the build and before the zip -->
        <!-- own user/cache dir: upstream's conf points bin/netbeans at ${DEFAULT_USERDIR_ROOT}/dev,
             the userdir a regular Apache NetBeans dev build uses. Sharing it leaks its Swing
             window-system state and its persisted module status: nbfx modules once recorded there
             as disabled stay disabled, and the FX launcher never starts. -->
        <replaceregexp file="${nbfx.sub.dir}/nbbuild/netbeans/etc/netbeans.conf" byline="true"
                       match="^(netbeans_default_(user|cache)dir=&quot;\$\{DEFAULT_(USER|CACHE)DIR_ROOT\})/[^/&quot;]+&quot;"
                       replace="\1/${nbfx.dist.userdir}&quot;"/>
        <!-- no settings import on first start: both launchers pass
             -J-Dnetbeans.importclass=org.netbeans.upgrade.AutoUpgrade (a Swing wizard in the nb
             cluster, which nbfx does not ship). core.startup runs that class on every userdir
             without var/imported and exits silently when it cannot be loaded. netbeans64.exe has
             the flag compiled in, so instead of removing it, override it: both launchers put
             netbeans_default_options after their own flags and the last -D wins. The override
             names a no-op class (release/launcher), which must be on the startup classpath (the
             import runs before the module system): core/*.jar of every cluster is. Using the
             same path on every OS means a test on macOS/Linux covers the Windows launcher too. -->
        <property name="nbfx.dist.importclass" value="com.gluonhq.netbeans.nbfx.startup.NoImport"/>
        <property name="nbfx.dist.noimport.classes" location="${nbfx.build.dir}/noimport/classes"/>
        <delete dir="${nbfx.dist.noimport.classes}" quiet="true"/>
        <mkdir dir="${nbfx.dist.noimport.classes}"/>
        <javac srcdir="${basedir}/release/launcher/src" destdir="${nbfx.dist.noimport.classes}"
               release="25" includeantruntime="false" encoding="UTF-8"/>
        <jar destfile="${nbfx.sub.dir}/nbbuild/netbeans/nbfx-platform/core/nbfx-noimport.jar"
             basedir="${nbfx.dist.noimport.classes}"/>
        <replaceregexp file="${nbfx.sub.dir}/nbbuild/netbeans/etc/netbeans.conf" byline="true"
                       match="^(netbeans_default_options=&quot;(?!.*netbeans\.importclass=).*)&quot;\s*$"
                       replace="\1 -J-Dnetbeans.importclass=${nbfx.dist.importclass}&quot;"/>
        <!-- bin/netbeans tells the platform cluster apart from the rest with a substring match
             ("grep -v platform" / "grep platform" on etc/netbeans.clusters), which also throws
             away nbfx-platform: every nbfx-ide module then fails with "nbfx.api was needed and
             not found". Match the whole line instead. -->
        <replace file="${nbfx.sub.dir}/nbbuild/netbeans/bin/netbeans">
            <replacefilter token="| grep -v platform |" value="| grep -v &quot;^platform$&quot; |"/>
            <replacefilter token="| grep platform |" value="| grep &quot;^platform$&quot; |"/>
        </replace>
        <!-- the edits are silent no-ops when upstream changes the launcher; fail instead of
             shipping a release that exits on its first start -->
        <loadfile property="nbfx.dist.launcher" srcFile="${nbfx.sub.dir}/nbbuild/netbeans/bin/netbeans"/>
        <loadfile property="nbfx.dist.conf" srcFile="${nbfx.sub.dir}/nbbuild/netbeans/etc/netbeans.conf"/>
        <fail message="bin/netbeans matches 'platform' as a substring; upstream launcher changed, update build.xml:-dist-launcher">
            <condition>
                <or>
                    <contains string="${nbfx.dist.launcher}" substring="grep platform"/>
                    <contains string="${nbfx.dist.launcher}" substring="grep -v platform"/>
                </or>
            </condition>
        </fail>
        <fail message="etc/netbeans.conf does not override netbeans.importclass with ${nbfx.dist.importclass}; upstream conf changed, update build.xml:-dist-launcher">
            <condition>
                <not><matches string="${nbfx.dist.conf}" pattern="(?m)^netbeans_default_options=&quot;.* -J-Dnetbeans\.importclass=\Q${nbfx.dist.importclass}\E&quot;\s*$"/></not>
            </condition>
        </fail>
        <fail message="etc/netbeans.conf does not use the '${nbfx.dist.userdir}' userdir; upstream conf changed, update build.xml:-dist-launcher">
            <condition>
                <not><contains string="${nbfx.dist.conf}" substring="DIR_ROOT}/${nbfx.dist.userdir}&quot;"/></not>
            </condition>
        </fail>
    </target>

    <target name="javafx-fetch"
            description="Download (pinned, checksum-verified) and unpack the JavaFX SDK into libs.javafx (-Dnbfx.javafx.platform=...)">
        <fail unless="nbfx.javafx.platform"
              message="No JavaFX SDK for ${os.name}/${os.arch}; pass -Dnbfx.javafx.platform=&lt;id&gt; (ids in ${nbfx.javafx.module}/javafx-sdk.properties)"/>
        <mkdir dir="${nbfx.build.dir}"/>
        <nbfx-javafx-unpack platform="${nbfx.javafx.platform}" dest="${nbfx.javafx.module}/release"
                            stamp="${nbfx.build.dir}/javafx-sdk.stamp"/>
        <!-- the harness copies release/ into the cluster but never deletes from it, so a built
             cluster would keep the natives and licence texts of another platform (or of the old
             lib/amd64, lib/amd64/linux layout): mirror the two dirs that only libs.javafx fills -->
        <available property="nbfx.javafx.cluster.built" file="${nbfx.sub.dir}/nbbuild/netbeans/nbfx-platform/modules" type="dir"/>
        <sync todir="${nbfx.sub.dir}/nbbuild/netbeans/nbfx-libs/modules/lib" if:set="nbfx.javafx.cluster.built">
            <fileset dir="${nbfx.javafx.module}/release/modules/lib"/>
        </sync>
        <sync todir="${nbfx.sub.dir}/nbbuild/netbeans/nbfx-libs/legal/javafx" if:set="nbfx.javafx.cluster.built">
            <fileset dir="${nbfx.javafx.module}/release/legal/javafx"/>
        </sync>
    </target>

    <target name="bootstrap" depends="submodule,patches,cluster-config,-prune-excluded,javafx-fetch,overlay"
            description="Bring a clean checkout to a buildable state"/>

    <target name="build" depends="bootstrap" description="Build the nbfx cluster config">
        <ant antfile="${nbfx.sub.dir}/nbbuild/build.xml" dir="${nbfx.sub.dir}/nbbuild"
             target="build" inheritall="false">
            <property name="cluster.config" value="${nbfx.cluster.config}"/>
            <property name="clusters.list.file" location="${nbfx.cluster.file}"/>
        </ant>
    </target>

    <target name="run" depends="bootstrap" description="Launch the FX app on the lean nbfx cluster set">
        <ant antfile="${nbfx.sub.dir}/nbbuild/build.xml" dir="${nbfx.sub.dir}/nbbuild"
             target="tryme" inheritall="false">
            <property name="cluster.config" value="${nbfx.cluster.config}"/>
            <property name="clusters.list.file" location="${nbfx.cluster.file}"/>
        </ant>
    </target>

    <!-- ======================================================================== -->
    <!-- single module (fast dev loop)                                            -->
    <!-- ======================================================================== -->

    <target name="-module-check">
        <fail unless="module">Set -Dmodule=&lt;cluster dir&gt;/&lt;module dir&gt;, e.g.
  ant module -Dmodule=nbfx-platform/c.gluonhq.netbeans.nbfx.progress</fail>
        <fail message="no module at ${basedir}/${module} (expected &lt;cluster dir&gt;/&lt;module dir&gt;, e.g. nbfx-platform/c.gluonhq.netbeans.nbfx.progress)">
            <condition><not><available file="${basedir}/${module}/build.xml"/></not></condition>
        </fail>
        <fail message="${nbfx.sub.dir}/${module} is not overlaid; run `ant bootstrap` once">
            <condition><not><available file="${nbfx.sub.dir}/${module}/build.xml"/></not></condition>
        </fail>
        <property name="module.target" value="netbeans"/>
    </target>

    <target name="-module-sync" unless="nbfx.overlay.symlink">
        <!-- sync overlay: mirror just this module into the submodule (a symlink overlay is the
             same files already) -->
        <sync todir="${nbfx.sub.dir}/${module}" includeEmptyDirs="false">
            <fileset dir="${module}" excludes="build/**,dist/**"/>
            <preserveintarget>
                <include name="build/**"/>
                <include name="dist/**"/>
            </preserveintarget>
        </sync>
    </target>

    <target name="module" depends="-module-check,-module-sync"
            description="Build one nbfx module into the dist (-Dmodule=&lt;cluster dir&gt;/&lt;module dir&gt;, -Dmodule.target=netbeans)">
        <!-- Runs the module's own build.xml through its path under the submodule, so that its
             ../../nbbuild import resolves there (Ant resolves that import lexically against
             the build file's path, which is why the logical path through the symlink works;
             a shell cd'ed into the symlink would hand Ant the physical path instead).
             No bootstrap: the dist of the dependencies must exist (`ant build` once). -->
        <ant antfile="${nbfx.sub.dir}/${module}/build.xml" dir="${nbfx.sub.dir}/${module}"
             target="${module.target}" inheritall="false"/>
        <echo message="[nbfx] built ${module} (${module.target}); `ant run` launches with it"/>
    </target>

    <target name="check-purity" description="Run the nbfx purity/guardrail checks">
        <ant antfile="${basedir}/check-purity.xml" dir="${basedir}"
             target="check-purity" inheritall="false">
            <property name="nbfx.dist.dir" location="${nbfx.sub.dir}/nbbuild/netbeans"/>
        </ant>
    </target>

    <target name="update-upstream"
            description="Bump the submodule revision and re-apply/verify the patches (set -Dnbfx.submodule.commit)">
        <exec executable="git" dir="${nbfx.sub.dir}" failonerror="true">
            <arg value="fetch"/>
            <arg value="origin"/>
        </exec>
        <!-- discard the previously applied patches + generated cluster.properties so the new
             revision can be checked out cleanly; untracked build outputs are kept -->
        <exec executable="git" dir="${nbfx.sub.dir}" failonerror="true">
            <arg value="reset"/>
            <arg value="--hard"/>
        </exec>
        <exec executable="git" dir="${nbfx.sub.dir}" failonerror="true">
            <arg value="checkout"/>
            <arg value="--quiet"/>
            <arg value="${nbfx.submodule.commit}"/>
        </exec>
        <delete quiet="true">
            <fileset dir="${nbfx.build.dir}" includes="patches-*.stamp"/>
        </delete>
        <nbfx-unoverlay-one cluster="nbfx-libs"/>
        <nbfx-unoverlay-one cluster="nbfx-api"/>
        <nbfx-unoverlay-one cluster="nbfx-platform"/>
        <nbfx-unoverlay-one cluster="nbfx-ide"/>
        <nbfx-unoverlay-one cluster="nbfx-java"/>
        <antcall target="patches-check"/>
        <antcall target="bootstrap"/>
        <echo message="[nbfx] upstream bumped to ${nbfx.submodule.commit}; update nbfx.properties + the submodule gitlink and commit"/>
    </target>

    <target name="clean" description="Remove the overlay, generated cluster config and submodule build outputs">
        <antcall target="unoverlay"/>
        <delete dir="${nbfx.build.dir}"/>
        <exec executable="git" dir="${nbfx.sub.dir}" failonerror="false">
            <arg value="clean"/>
            <arg value="-Xdf"/>
        </exec>
        <exec executable="git" dir="${nbfx.sub.dir}" failonerror="false">
            <arg value="checkout"/>
            <arg value="--"/>
            <arg value="nbbuild/cluster.properties"/>
        </exec>
    </target>

    <target name="print-config" description="Print the effective configuration">
        <echo message="nbfx.submodule.dir      = ${nbfx.submodule.dir}"/>
        <echo message="nbfx.submodule.commit   = ${nbfx.submodule.commit}"/>
        <echo message="nbfx.overlay            = ${nbfx.overlay}"/>
        <echo message="nbfx.clusters           = ${nbfx.clusters}"/>
        <echo message="nbfx.cluster.config     = ${nbfx.cluster.config}"/>
        <echo message="nbfx.cluster.file       = ${nbfx.cluster.file}"/>
        <echo message="nbfx.patches.dir        = ${nbfx.patches.dir}"/>
        <echo message="nbfx.javafx.version     = ${nbfx.javafx.version}"/>
        <echo message="nbfx.javafx.platform    = ${nbfx.javafx.platform}"/>
    </target>

    <target name="help" description="Show the available targets">
        <echo>
nbfx build harness — targets:

  bootstrap        submodule + patches + cluster config + JavaFX SDK + overlay
  build            build the '${nbfx.cluster.config}' cluster config
  run              launch the FX app (lean cluster set)
  module           build one module only: -Dmodule=nbfx-platform/c.gluonhq.netbeans.nbfx.progress
                   (-Dmodule.target=netbeans|clean|test ...); seconds instead of a full build
  check-purity     purity/guardrail checks
  submodule        init/update the netbeans submodule at the pinned revision
  patches          apply the upstream patch set (patches/*.patch)
  patches-check    verify the patches still apply (after an upstream bump)
  cluster-config   regenerate build/cluster.properties
  javafx-fetch     download + unpack the pinned JavaFX SDK into libs.javafx
                   (build platform, or -Dnbfx.javafx.platform=macos-aarch64|macos-x64|windows-x64|linux-x64)
  overlay          sync/symlink the nbfx clusters into the submodule
  unoverlay        remove the overlay
  update-upstream  fetch a new submodule revision and re-apply patches
  clean            remove overlay + generated files + submodule build outputs
  print-config     print the effective configuration

release (RELEASING.md):
  rat              licence headers of the sources (Apache Rat)
  headers          add the missing licence headers (-Ddry.run=true lists them only)
  release          release-src + release-bin + release-sign + release-verify
                   -Dnbfx.rc=rc1 -Dnbfx.gpg.key=&lt;fingerprint&gt; (-Dnbfx.release.dryrun=true)
  release-src      build/release/nbfx-${nbfx.version}-src.tar.gz (git archive of the tag)
  release-bin      build/release/nbfx-${nbfx.version}-bin.zip (the nbfx cluster config)
  release-sign     .asc + .sha512 for every artefact
  release-verify   signatures against KEYS, checksums, licence files, Rat

Override properties on the command line, e.g.
  ant build -Dnbfx.overlay=symlink -Dnbfx.submodule.commit=&lt;sha&gt;
or persistently in nbfx-local.properties (git-ignored), e.g. nbfx.overlay=symlink
so that netbeans/nbfx-* are the real cluster dirs (Unix): edit on either side, no sync.
</echo>
    </target>

</project>
