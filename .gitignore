# nbfx build outputs (per module)
/*/build/
# the JavaFX SDK, unpacked by `ant javafx-fetch` (javafx-sdk.properties)
/nbfx-libs/c.gluonhq.netbeans.nbfx.libs.javafx/release/
/*/*/build/
# generated at bootstrap (own cluster configuration)
/build/
# local overrides
/nbfx-local.properties
# the netbeans submodule keeps its own ignore rules; the overlay entries are
# written to the submodule's info/exclude by `ant overlay`
#Other IDEs
.idea
# macOS Finder metadata
.DS_Store
