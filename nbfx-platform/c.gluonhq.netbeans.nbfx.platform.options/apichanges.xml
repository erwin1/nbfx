<?xml-stylesheet type="text/xml" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_options">NetBeansFX Options API</apidef>
    </apidefs>
    <changes>
        <change id="options.initial">
            <api name="netbeansfx_options"/>
            <summary>Initial pure-JavaFX Options dialog.</summary>
            <version major="1" minor="0"/>
            <date day="8" month="10" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Introduces <code>FxOptionsPanel</code>, <code>OptionsPanelEntry</code>,
                <code>OptionsRegistry</code> and <code>FxOptionsDialog</code>. Panels are registered
                with <code>@OptionsRegistration</code> under <code>NbFx/Options</code>. The API is
                under development until the MVP freeze.
            </description>
            <class package="com.gluonhq.netbeans.nbfx.options" name="FxOptionsPanel"/>
            <class package="com.gluonhq.netbeans.nbfx.options" name="OptionsRegistry"/>
            <class package="com.gluonhq.netbeans.nbfx.options" name="FxOptionsDialog"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Options API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Options API</a>.</p>
            <hr/><standard-changelists module-code-name="com.gluonhq.netbeans.nbfx.options"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
