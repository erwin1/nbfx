<?xml-stylesheet type="text/xml" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_output">NetBeansFX Output API</apidef>
    </apidefs>
    <changes>
        <change id="output.console.text">
            <api name="netbeansfx_output"/>
            <summary>FxConsole exposes the accumulated text.</summary>
            <version major="1" minor="0"/>
            <date day="21" month="10" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>FxConsole.text()</code>, the text accumulated so far; the headless W0
                scenario uses it to assert build and run output without reaching into the view.
            </description>
            <class package="org.netbeans.modules.nbfx.output" name="FxConsole"/>
        </change>
        <change id="output.initial">
            <api name="netbeansfx_output"/>
            <summary>Initial pure-JavaFX output consoles.</summary>
            <version major="1" minor="0"/>
            <date day="8" month="10" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Introduces <code>FxOutput</code>, <code>FxConsole</code> and the Output view,
                registered under <code>NbFx/Views</code>. Build and run activities write into named
                consoles. The API is under development until the MVP freeze.
            </description>
            <class package="org.netbeans.modules.nbfx.output" name="FxOutput"/>
            <class package="org.netbeans.modules.nbfx.output" name="FxConsole"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Output API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Output API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.output"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
