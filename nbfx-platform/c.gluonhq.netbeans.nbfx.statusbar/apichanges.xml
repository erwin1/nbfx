<?xml-stylesheet type="text/xml" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_statusbar">NetBeansFX Status Bar API</apidef>
    </apidefs>
    <changes>
        <change id="statusbar.initial">
            <api name="netbeansfx_statusbar"/>
            <summary>Initial pure-JavaFX status bar SPI and registry.</summary>
            <version major="1" minor="0"/>
            <date day="8" month="10" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Introduces <code>FxStatusElement</code>, <code>StatusElement</code>,
                <code>StatusElementRegistry</code> and <code>FxStatusBar</code>. Elements are
                registered with <code>@FxStatusRegistration</code> and discovered from
                <code>NbFx/Status</code>. The API is under development until the MVP freeze.
            </description>
            <class package="com.gluonhq.netbeans.nbfx.statusbar" name="FxStatusElement"/>
            <class package="com.gluonhq.netbeans.nbfx.statusbar" name="StatusElement"/>
            <class package="com.gluonhq.netbeans.nbfx.statusbar" name="StatusElementRegistry"/>
            <class package="com.gluonhq.netbeans.nbfx.statusbar" name="FxStatusBar"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Status Bar API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Status Bar API</a>.</p>
            <hr/><standard-changelists module-code-name="com.gluonhq.netbeans.nbfx.statusbar"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
