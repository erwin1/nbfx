<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xml" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_windows">NetBeansFX Windows API</apidef>
    </apidefs>
    <changes>
        <change id="windows.environment">
            <api name="netbeansfx_windows"/>
            <summary>Window system host SPI.</summary>
            <version major="1" minor="0"/>
            <date day="8" month="10" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Introduces <code>WindowEnvironment</code>, the host contract the JavaFX window
                system resolves from the Lookup for detached-window bars, navigator reveal, project
                switching and tab home resolution, replacing static setters on the tab pane. Also
                introduces <code>ViewRegistration</code> and <code>ViewRegistry</code>, which
                discover the views registered under <code>NbFx/Views</code> by
                <code>@FxViewRegistration</code>. The API is under development until the MVP freeze.
            </description>
            <class package="com.gluonhq.netbeans.nbfx.windows" name="WindowEnvironment"/>
            <class package="com.gluonhq.netbeans.nbfx.windows" name="ViewRegistration"/>
            <class package="com.gluonhq.netbeans.nbfx.windows" name="ViewRegistry"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Windows API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Windows API</a>.</p>
            <hr/><standard-changelists module-code-name="com.gluonhq.netbeans.nbfx.windows"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
