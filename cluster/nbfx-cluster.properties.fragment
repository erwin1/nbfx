# =============================================================================
# nbfx clusters (appended to nbbuild/cluster.properties by `ant cluster-config`)
#
# The FX replacements parallel the NetBeans platform/ide/java clusters; the
# dependency direction is nbfx-libs -> nbfx-api -> nbfx-platform -> nbfx-ide ->
# nbfx-java. Only the dedicated `nbfx` cluster config pulls these in.
# `nbfx-javafx` is created when its first module lands (M3).
# =============================================================================

clusters.config.nbfx.list=\
        nb.cluster.platform,\
        nb.cluster.nbfx-libs,\
        nb.cluster.nbfx-api,\
        nb.cluster.nbfx-platform,\
        nb.cluster.nbfx-ide,\
        nb.cluster.nbfx-java,\
        nb.cluster.java,\
        nb.cluster.ide,\
        nb.cluster.extide,\
        nb.cluster.apisupport

# --- nbfx-libs: bundled external libraries ------------------------------------
nb.cluster.nbfx-libs.dir=nbfx-libs
nb.cluster.nbfx-libs.depends=
nb.cluster.nbfx-libs=\
        nbfx.libs.javafx

# --- nbfx-api: published/shared APIs ------------------------------------------
nb.cluster.nbfx-api.dir=nbfx-api
nb.cluster.nbfx-api.depends=\
        nb.cluster.platform,\
        nb.cluster.nbfx-libs
nb.cluster.nbfx-api=\
        nbfx.api.actions,\
        nbfx.api.dialogs,\
        nbfx.api.editor,\
        nbfx.api.elements,\
        nbfx.api.file,\
        nbfx.api.layer,\
        nbfx.api.options,\
        nbfx.api.progress,\
        nbfx.api.project,\
        nbfx.api.property,\
        nbfx.api.search,\
        nbfx.api.status,\
        nbfx.api.usages,\
        nbfx.api.views,\
        nbfx.api.wizard

# --- nbfx-platform: FX replacements for platform/ -----------------------------
nb.cluster.nbfx-platform.dir=nbfx-platform
# platform.editor uses the upstream NetBeans lexer/queries modules, which live in the
# upstream ide cluster. This is an upstream reuse edge (PLAN §2 Rule 1), not an nbfx
# layer edge: no nbfx-ide module is a build prerequisite of an nbfx-platform module.
nb.cluster.nbfx-platform.depends=\
        nb.cluster.platform,\
        nb.cluster.nbfx-api,\
        nb.cluster.ide
nb.cluster.nbfx-platform=\
        nbfx.platform.actions,\
        nbfx.platform.editor,\
        nbfx.platform.macos,\
        nbfx.platform.menus,\
        nbfx.platform.options,\
        nbfx.platform.output,\
        nbfx.platform.progress,\
        nbfx.platform.status,\
        nbfx.platform.wizard,\
        nbfx.platform.workspace

# --- nbfx-ide: FX replacements for ide/ + the app shell -----------------------
nb.cluster.nbfx-ide.dir=nbfx-ide
nb.cluster.nbfx-ide.depends=\
        nb.cluster.nbfx-platform,\
        nb.cluster.ide,\
        nb.cluster.java
nb.cluster.nbfx-ide=\
        nbfx.editor.actions,\
        nbfx.ide.build,\
        nbfx.ide.debug,\
        nbfx.ide.editor.css,\
        nbfx.ide.editor.xml,\
        nbfx.ide.file,\
        nbfx.ide.plugins,\
        nbfx.ide.project.actions,\
        nbfx.ide.project.customizer,\
        nbfx.ide.search,\
        nbfx.ide.structure,\
        nbfx.ide.structure.css,\
        nbfx.ide.structure.xml,\
        nbfx.ide.usages,\
        nbfx.ide.vcs,\
        nbfx.launcher,\
        nbfx.project,\
        nbfx.project.context,\
        nbfx.project.ui,\
        nbfx.project.ui.api,\
        nbfx.propertysheet,\
        nbfx.ui

# --- nbfx-java: FX replacements for java/ + extide/ project types -------------
nb.cluster.nbfx-java.dir=nbfx-java
nb.cluster.nbfx-java.depends=\
        nb.cluster.nbfx-ide,\
        nb.cluster.java,\
        nb.cluster.extide,\
        nb.cluster.apisupport
nb.cluster.nbfx-java=\
        nbfx.java.build.ant,\
        nbfx.java.editor,\
        nbfx.java.gradle,\
        nbfx.java.gradle.structure,\
        nbfx.java.j2seproject,\
        nbfx.java.maven,\
        nbfx.java.maven.structure,\
        nbfx.java.model,\
        nbfx.java.navigation,\
        nbfx.java.navigation.structure,\
        nbfx.java.usages
