<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://www.netbeans.org/ns/project/1">
    <type>org.netbeans.modules.apisupport.project</type>
    <configuration>
        <data xmlns="http://www.netbeans.org/ns/nb-module-project/3">
            <code-name-base>com.gluonhq.netbeans.nbfx.lib.javafx</code-name-base>
            <module-dependencies>
                <dependency>
                    <code-name-base>org.openide.util</code-name-base>
                    <build-prerequisite/>
                    <compile-dependency/>
                    <run-dependency>
                        <specification-version>9.42</specification-version>
                    </run-dependency>
                </dependency>
            </module-dependencies>
            <public-packages>
                <subpackages>javafx</subpackages>
                <subpackages>com.sun.javafx</subpackages>
                <subpackages>com.sun.glass</subpackages>
                <subpackages>com.sun.prism</subpackages>
                <subpackages>jfx.incubator</subpackages>
                <subpackages>com.sun.jfx.incubator</subpackages>
            </public-packages>
            <class-path-extension>
                <runtime-relative-path>ext/javafx.base.jar</runtime-relative-path>
                <binary-origin>release/modules/ext/javafx.base.jar</binary-origin>
            </class-path-extension>
            <class-path-extension>
                <runtime-relative-path>ext/javafx.controls.jar</runtime-relative-path>
                <binary-origin>release/modules/ext/javafx.controls.jar</binary-origin>
            </class-path-extension>
            <class-path-extension>
                <runtime-relative-path>ext/javafx.fxml.jar</runtime-relative-path>
                <binary-origin>release/modules/ext/javafx.fxml.jar</binary-origin>
            </class-path-extension>
            <class-path-extension>
                <runtime-relative-path>ext/javafx.graphics.jar</runtime-relative-path>
                <binary-origin>release/modules/ext/javafx.graphics.jar</binary-origin>
            </class-path-extension>
            <class-path-extension>
                <runtime-relative-path>ext/jfx.incubator.input.jar</runtime-relative-path>
                <binary-origin>release/modules/ext/jfx.incubator.input.jar</binary-origin>
            </class-path-extension>
            <class-path-extension>
                <runtime-relative-path>ext/jfx.incubator.richtext.jar</runtime-relative-path>
                <binary-origin>release/modules/ext/jfx.incubator.richtext.jar</binary-origin>
            </class-path-extension>
        </data>
    </configuration>
</project>
