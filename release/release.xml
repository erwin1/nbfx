<!--
  nbfx release targets, imported by ../build.xml. The procedure is in RELEASING.md.

      ant rat                                       licence headers (Apache Rat)
      ant release -Dnbfx.rc=rc1 -Dnbfx.gpg.key=<fingerprint>
          = release-src release-bin release-sign release-verify

  Artefacts land in ${nbfx.build.dir}/release:
      nbfx-<version>-src.tar.gz   the source release (git archive of the tag)
      nbfx-<version>-bin.zip      the convenience binary (the nbfx cluster config), for macOS
                                  aarch64/x64, Windows x64 and Linux x64
  each with a detached armored signature (.asc) and a SHA-512 checksum (.sha512).
  An RC is built under the final file names, so promoting it re-uploads the same bytes.
-->
<project name="nbfx-release">

    <property name="nbfx.release.dir" location="${nbfx.build.dir}/release"/>
    <property name="nbfx.release.name" value="nbfx-${nbfx.version}"/>
    <property name="nbfx.release.src" location="${nbfx.release.dir}/${nbfx.release.name}-src.tar.gz"/>
    <property name="nbfx.release.bin" location="${nbfx.release.dir}/${nbfx.release.name}-bin.zip"/>
    <property name="nbfx.rat.jar" location="${nbfx.build.dir}/tools/apache-rat-${nbfx.rat.version}.jar"/>

    <condition property="nbfx.release.tag" value="${nbfx.version}-${nbfx.rc}" else="${nbfx.version}">
        <and>
            <isset property="nbfx.rc"/>
            <not><equals arg1="${nbfx.rc}" arg2=""/></not>
        </and>
    </condition>

    <!-- ======================================================================== -->
    <!-- rat                                                                      -->
    <!-- ======================================================================== -->

    <target name="-rat-jar">
        <mkdir dir="${nbfx.build.dir}/tools"/>
        <get src="https://repo1.maven.org/maven2/org/apache/rat/apache-rat/${nbfx.rat.version}/apache-rat-${nbfx.rat.version}.jar"
             dest="${nbfx.rat.jar}" skipexisting="true"/>
        <checksum file="${nbfx.rat.jar}" algorithm="SHA-256" property="${nbfx.rat.sha256}" verifyproperty="nbfx.rat.ok"/>
        <fail message="${nbfx.rat.jar} does not match nbfx.rat.sha256; delete it and retry">
            <condition><isfalse value="${nbfx.rat.ok}"/></condition>
        </fail>
    </target>

    <!-- runs Rat over @{dir} with @{dir}'s own exclusions; the netbeans submodule and git-ignored
         files are never scanned -->
    <macrodef name="nbfx-rat">
        <attribute name="dir"/>
        <attribute name="report"/>
        <sequential>
            <mkdir dir="${nbfx.build.dir}/rat"/>
            <java jar="${nbfx.rat.jar}" fork="true" resultproperty="nbfx.rat.result.@{report}">
                <arg line="--input-exclude-std MISC GIT IDEA MAC"/>
                <arg line="--input-exclude-parsed-scm GIT"/>
                <arg line="--input-exclude netbeans/** build/**"/>
                <arg value="--input-exclude-file"/>
                <arg file="@{dir}/release/rat-excludes.txt"/>
                <arg value="--output-file"/>
                <arg file="${nbfx.build.dir}/rat/@{report}.txt"/>
                <arg value="--"/>
                <arg file="@{dir}"/>
            </java>
            <fail message="Rat found files without an approved licence header; see ${nbfx.build.dir}/rat/@{report}.txt (section 'Files with unapproved licenses')">
                <condition><not><equals arg1="${nbfx.rat.result.@{report}}" arg2="0"/></not></condition>
            </fail>
            <echo message="[nbfx] rat: all files carry an approved licence (@{dir})"/>
        </sequential>
    </macrodef>

    <target name="rat" depends="-rat-jar" description="Check the licence headers of the nbfx sources (Apache Rat)">
        <nbfx-rat dir="${basedir}" report="rat-report"/>
    </target>

    <target name="headers" description="Add the ASF licence header to files that lack one (-Ddry.run=true to list only)">
        <condition property="nbfx.headers.args" value="--dry-run" else="">
            <istrue value="${dry.run}"/>
        </condition>
        <java sourcefile="${basedir}/release/tools/Headers.java" fork="true" dir="${basedir}" failonerror="true">
            <arg line="${nbfx.headers.args}"/>
        </java>
    </target>

    <!-- ======================================================================== -->
    <!-- release                                                                  -->
    <!-- ======================================================================== -->

    <target name="-release-check">
        <fail message="Set nbfx.version in nbfx.properties">
            <condition><not><isset property="nbfx.version"/></not></condition>
        </fail>
        <!-- the submodule is always modified (patches, overlay), so it is ignored here -->
        <exec executable="git" dir="${basedir}" outputproperty="nbfx.release.dirty" failonerror="true">
            <arg line="status --porcelain --ignore-submodules=all"/>
        </exec>
        <exec executable="git" dir="${basedir}" outputproperty="nbfx.release.head.tags" failonerror="true">
            <arg line="tag --points-at HEAD"/>
        </exec>
        <condition property="nbfx.release.tagged">
            <matches string="${nbfx.release.head.tags}" pattern="(?m)^\Q${nbfx.release.tag}\E$"/>
        </condition>
        <fail message="The working tree has uncommitted changes:${line.separator}${nbfx.release.dirty}">
            <condition>
                <and>
                    <not><equals arg1="${nbfx.release.dirty}" arg2=""/></not>
                    <not><istrue value="${nbfx.release.dryrun}"/></not>
                </and>
            </condition>
        </fail>
        <fail message="HEAD is not tagged ${nbfx.release.tag}; tag it (git tag -s -a ${nbfx.release.tag}) or pass -Dnbfx.release.dryrun=true">
            <condition>
                <and>
                    <not><isset property="nbfx.release.tagged"/></not>
                    <not><istrue value="${nbfx.release.dryrun}"/></not>
                </and>
            </condition>
        </fail>
        <echo message="[nbfx] releasing ${nbfx.release.name} (tag ${nbfx.release.tag})"/>
    </target>

    <target name="release-src" depends="-release-check"
            description="Create the source release build/release/nbfx-VERSION-src.tar.gz (git archive of HEAD)">
        <mkdir dir="${nbfx.release.dir}"/>
        <!-- git archive is reproducible: the same commit gives the same bytes. The -c options pin the
             settings that change its output, so the CI comparison (release-verify.yml) holds whatever
             the release manager's git config says -->
        <exec executable="git" dir="${basedir}" failonerror="true">
            <arg line="-c core.autocrlf=false -c tar.umask=0002"/>
            <arg value="archive"/>
            <arg value="--format=tar.gz"/>
            <arg value="--prefix=${nbfx.release.name}/"/>
            <arg value="--output=${nbfx.release.src}"/>
            <arg value="HEAD"/>
        </exec>
        <echo message="[nbfx] ${nbfx.release.src}"/>
    </target>

    <!-- Unpacks the four pinned SDKs into @{dir}/<platform>/ and assembles from them, in
         @{dir}/universal/nbfx-platform, lib.javafx's part of the binary for all platforms:
         - modules/ext/javafx.graphics.jar: the union of the four. OpenJFX's graphics jar differs per
           platform only by platform packages (glass mac/win/gtk, prism d3d/es2, fonts); the entries the
           platforms share are byte-identical (release-verify checks the union against the SDKs);
         - the other jars from linux-x64: they differ between the SDKs only by a build timestamp and
           compiled CSS of the same build;
         - modules/lib: the Windows .dll and Linux .so flat, the macOS .dylib per architecture in
           aarch64/ and x86_64/. StandardModule.findLibrary looks in lib/, then lib/<os.arch>/, and the
           file names differ per OS (glass.dll, libglass.so, libglass.dylib), so only the two macOS
           architectures need their own dir;
         - legal/javafx: the union; same-named texts are identical in all four SDKs. -->
    <macrodef name="nbfx-javafx-universal">
        <attribute name="dir"/>
        <sequential>
            <nbfx-javafx-unpack platform="macos-aarch64" dest="@{dir}/macos-aarch64/nbfx-platform" stamp="@{dir}/macos-aarch64.stamp"/>
            <nbfx-javafx-unpack platform="macos-x64" dest="@{dir}/macos-x64/nbfx-platform" stamp="@{dir}/macos-x64.stamp"/>
            <nbfx-javafx-unpack platform="windows-x64" dest="@{dir}/windows-x64/nbfx-platform" stamp="@{dir}/windows-x64.stamp"/>
            <nbfx-javafx-unpack platform="linux-x64" dest="@{dir}/linux-x64/nbfx-platform" stamp="@{dir}/linux-x64.stamp"/>
            <local name="u"/>
            <property name="u" location="@{dir}/universal/nbfx-platform"/>
            <delete dir="@{dir}/universal"/>
            <copy todir="${u}/modules/ext">
                <fileset dir="@{dir}/linux-x64/nbfx-platform/modules/ext" excludes="javafx.graphics.jar"/>
            </copy>
            <!-- the macOS x64 jar is identical to the aarch64 one; unpacking over each other only
                 rewrites identical shared entries -->
            <delete dir="@{dir}/graphics"/>
            <unzip src="@{dir}/macos-aarch64/nbfx-platform/modules/ext/javafx.graphics.jar" dest="@{dir}/graphics"/>
            <unzip src="@{dir}/windows-x64/nbfx-platform/modules/ext/javafx.graphics.jar" dest="@{dir}/graphics"/>
            <unzip src="@{dir}/linux-x64/nbfx-platform/modules/ext/javafx.graphics.jar" dest="@{dir}/graphics"/>
            <zip destfile="${u}/modules/ext/javafx.graphics.jar" basedir="@{dir}/graphics"/>
            <copy todir="${u}/modules/lib">
                <fileset dir="@{dir}/windows-x64/nbfx-platform/modules/lib"/>
                <fileset dir="@{dir}/linux-x64/nbfx-platform/modules/lib"/>
            </copy>
            <copy todir="${u}/modules/lib/aarch64">
                <fileset dir="@{dir}/macos-aarch64/nbfx-platform/modules/lib"/>
            </copy>
            <copy todir="${u}/modules/lib/x86_64">
                <fileset dir="@{dir}/macos-x64/nbfx-platform/modules/lib"/>
            </copy>
            <copy todir="${u}/legal/javafx">
                <fileset dir="@{dir}/macos-aarch64/nbfx-platform/legal/javafx"/>
                <fileset dir="@{dir}/macos-x64/nbfx-platform/legal/javafx"/>
                <fileset dir="@{dir}/windows-x64/nbfx-platform/legal/javafx"/>
                <fileset dir="@{dir}/linux-x64/nbfx-platform/legal/javafx"/>
            </copy>
        </sequential>
    </macrodef>

    <target name="release-bin" depends="-release-check,build,-dist-launcher"
            description="Create the convenience binary build/release/nbfx-VERSION-bin.zip (the nbfx cluster config, all platforms)">
        <property name="nbfx.dist.dir" location="${nbfx.sub.dir}/nbbuild/netbeans"/>
        <property name="nbfx.release.tmp" location="${nbfx.release.dir}/tmp"/>
        <delete dir="${nbfx.release.tmp}"/>
        <mkdir dir="${nbfx.release.tmp}"/>
        <!-- upstream licence summary of the bundled NetBeans libraries (LICENSE, NOTICE, licenses/) -->
        <ant antfile="${nbfx.sub.dir}/nbbuild/build.xml" dir="${nbfx.sub.dir}/nbbuild"
             target="create-mandatory-files-for-binary" inheritall="false">
            <property name="cluster.config" value="${nbfx.cluster.config}"/>
            <property name="clusters.list.file" location="${nbfx.cluster.file}"/>
        </ant>
        <!-- add the nbfx parts: the JavaFX licence (its jars are not in the upstream summary) and the notice -->
        <concat destfile="${nbfx.dist.dir}/LICENSE" append="true" fixlastline="yes">
            <filelist dir="${basedir}/release" files="bin-LICENSE-nbfx.txt"/>
        </concat>
        <concat destfile="${nbfx.dist.dir}/NOTICE.nbfx" fixlastline="yes">
            <filelist dir="${basedir}" files="NOTICE"/>
            <string>${line.separator}</string>
            <filelist dir="${nbfx.dist.dir}" files="NOTICE"/>
        </concat>
        <move file="${nbfx.dist.dir}/NOTICE.nbfx" tofile="${nbfx.dist.dir}/NOTICE" overwrite="true"/>
        <copy file="${basedir}/KEYS" todir="${nbfx.dist.dir}" overwrite="true"/>
        <!-- also the per-platform zips some earlier release-bin wrote -->
        <delete quiet="true">
            <fileset dir="${nbfx.release.dir}" includes="${nbfx.release.name}-bin*.zip" erroronmissingdir="false"/>
        </delete>
        <mkdir dir="${nbfx.release.dir}"/>
        <!-- the zip of the build; its lib.javafx part is the build machine's SDK and is replaced below -->
        <ant antfile="${nbfx.sub.dir}/nbbuild/build.xml" dir="${nbfx.sub.dir}/nbbuild"
             target="zip-cluster-config" inheritall="false">
            <property name="cluster.config" value="${nbfx.cluster.config}"/>
            <property name="clusters.list.file" location="${nbfx.cluster.file}"/>
            <property name="netbeans.dest" value="${nbfx.release.name}"/>
            <property name="zip.name" location="${nbfx.release.tmp}/build.zip"/>
        </ant>
        <nbfx-javafx-universal dir="${nbfx.release.tmp}/javafx"/>
        <property name="nbfx.release.javafx" location="${nbfx.release.tmp}/javafx/universal"/>
        <!-- lib.javafx's update_tracking lists every file of the module with its CRC-32 -->
        <property name="nbfx.release.tracking" value="nbfx-platform/update_tracking/com-gluonhq-netbeans-nbfx-lib-javafx.xml"/>
        <java sourcefile="${basedir}/release/tools/UpdateTracking.java" fork="true" failonerror="true">
            <arg file="${nbfx.dist.dir}/${nbfx.release.tracking}"/>
            <arg file="${nbfx.release.javafx}/nbfx-platform"/>
            <arg file="${nbfx.release.tmp}/tracking/${nbfx.release.tracking}"/>
            <arg value="modules/ext/"/>
            <arg value="modules/lib/"/>
            <arg value="legal/javafx/"/>
        </java>
        <!-- THIRDPARTY lists exactly the JavaFX files the zip bundles -->
        <pathconvert property="nbfx.release.javafx.files" pathsep="${line.separator}" dirsep="/">
            <sort>
                <fileset dir="${nbfx.release.javafx}" includes="nbfx-platform/modules/**"/>
            </sort>
            <mapper type="regexp" from="^.*[/\\](nbfx-platform[/\\].*)$" to="  \1"/>
        </pathconvert>
        <copy file="${basedir}/release/bin-THIRDPARTY.txt" tofile="${nbfx.release.tmp}/THIRDPARTY">
            <filterset>
                <filter token="VERSION" value="${nbfx.version}"/>
                <filter token="JAVAFX" value="${nbfx.javafx.version}"/>
                <filter token="URL" value="${nbfx.javafx.url}"/>
                <filter token="SHA256_MACOS_AARCH64" value="${nbfx.javafx.sha256.macos-aarch64}"/>
                <filter token="SHA256_MACOS_X64" value="${nbfx.javafx.sha256.macos-x64}"/>
                <filter token="SHA256_WINDOWS_X64" value="${nbfx.javafx.sha256.windows-x64}"/>
                <filter token="SHA256_LINUX_X64" value="${nbfx.javafx.sha256.linux-x64}"/>
                <filter token="FILES" value="${nbfx.release.javafx.files}"/>
            </filterset>
        </copy>
        <!-- both launchers, as Apache NetBeans ships them, but not the 32-bit netbeans.exe (no 32-bit
             JDK 25) -->
        <zip destfile="${nbfx.release.bin}">
            <zipfileset src="${nbfx.release.tmp}/build.zip">
                <exclude name="${nbfx.release.name}/nbfx-platform/modules/ext/**"/>
                <exclude name="${nbfx.release.name}/nbfx-platform/modules/lib/**"/>
                <exclude name="${nbfx.release.name}/nbfx-platform/legal/javafx/**"/>
                <exclude name="${nbfx.release.name}/${nbfx.release.tracking}"/>
                <exclude name="${nbfx.release.name}/bin/netbeans.exe"/>
            </zipfileset>
            <zipfileset dir="${nbfx.release.javafx}" prefix="${nbfx.release.name}"/>
            <zipfileset dir="${nbfx.release.tmp}/tracking" prefix="${nbfx.release.name}"/>
            <!-- zip-cluster-config only takes LICENSE, NOTICE, licenses/** and *.txt from the dist root -->
            <zipfileset file="${nbfx.release.tmp}/THIRDPARTY" fullpath="${nbfx.release.name}/THIRDPARTY"/>
            <zipfileset file="${nbfx.dist.dir}/KEYS" fullpath="${nbfx.release.name}/KEYS"/>
        </zip>
        <delete dir="${nbfx.release.tmp}"/>
        <echo message="[nbfx] ${nbfx.release.bin}"/>
    </target>

    <target name="release-sign" description="Sign (.asc) and checksum (.sha512) the release artefacts">
        <fail unless="nbfx.gpg.key" message="Set -Dnbfx.gpg.key=&lt;fingerprint&gt; (a key that is in KEYS)"/>
        <fileset id="nbfx.release.artefacts" dir="${nbfx.release.dir}" includes="*.tar.gz,*.zip"/>
        <delete quiet="true">
            <fileset dir="${nbfx.release.dir}" includes="*.asc,*.sha512"/>
        </delete>
        <apply executable="gpg" dir="${nbfx.release.dir}" failonerror="true" parallel="false" dest="${nbfx.release.dir}">
            <arg value="--local-user"/>
            <arg value="${nbfx.gpg.key}"/>
            <arg value="--armor"/>
            <arg value="--detach-sign"/>
            <arg value="--output"/>
            <targetfile/>
            <srcfile/>
            <fileset refid="nbfx.release.artefacts"/>
            <globmapper from="*" to="*.asc"/>
        </apply>
        <!-- "<hash> *<file>": the format sha512sum -c and shasum -a 512 -c read -->
        <checksum algorithm="SHA-512" fileext=".sha512" format="MD5SUM" forceoverwrite="true">
            <fileset refid="nbfx.release.artefacts"/>
        </checksum>
        <echo message="[nbfx] signed with ${nbfx.gpg.key}"/>
    </target>

    <target name="release-verify" depends="-rat-jar"
            description="Verify the release artefacts: signatures against KEYS, checksums, licence files, Rat">
        <property name="nbfx.verify.dir" location="${nbfx.build.dir}/release-verify"/>
        <!-- every file by name, or a missing .asc/.sha512 would simply not be checked -->
        <nbfx-verify-files dir="${nbfx.release.dir}" count="6"
            files="${nbfx.release.name}-src.tar.gz,${nbfx.release.name}-src.tar.gz.asc,${nbfx.release.name}-src.tar.gz.sha512,${nbfx.release.name}-bin.zip,${nbfx.release.name}-bin.zip.asc,${nbfx.release.name}-bin.zip.sha512"/>
        <!-- and nothing else, e.g. per-platform zips of an older release-bin -->
        <fail message="${nbfx.release.dir} holds files that are not part of the release">
            <condition>
                <resourcecount when="ne" count="6">
                    <fileset dir="${nbfx.release.dir}" includes="*"/>
                </resourcecount>
            </condition>
        </fail>
        <delete dir="${nbfx.verify.dir}"/>
        <mkdir dir="${nbfx.verify.dir}/gnupg"/>
        <chmod dir="${nbfx.verify.dir}/gnupg" perm="700" type="dir"/>
        <!-- a fresh keyring that only knows the keys in KEYS -->
        <exec executable="gpg" failonerror="true">
            <arg value="--homedir"/>
            <arg file="${nbfx.verify.dir}/gnupg"/>
            <arg value="--batch"/>
            <arg value="--import"/>
            <arg file="${basedir}/KEYS"/>
        </exec>
        <!-- dest: the <targetfile/> (the signed artefact) resolves against it, not against basedir;
             force: with dest, apply would skip an .asc that is not newer than its artefact -->
        <apply executable="gpg" dir="${nbfx.release.dir}" dest="${nbfx.release.dir}" force="true"
               failonerror="true" parallel="false">
            <arg value="--homedir"/>
            <arg file="${nbfx.verify.dir}/gnupg"/>
            <arg value="--batch"/>
            <arg value="--verify"/>
            <srcfile/>
            <targetfile/>
            <fileset dir="${nbfx.release.dir}" includes="*.asc"/>
            <globmapper from="*.asc" to="*"/>
        </apply>
        <checksum algorithm="SHA-512" fileext=".sha512" format="MD5SUM" verifyproperty="nbfx.release.sums.ok">
            <fileset dir="${nbfx.release.dir}" includes="*.tar.gz,*.zip"/>
        </checksum>
        <fail message="A .sha512 file does not match its artefact">
            <condition><isfalse value="${nbfx.release.sums.ok}"/></condition>
        </fail>
        <!-- the source release: licence files present, Rat clean, no compiled code (JavaFX is
             fetched at build time, javafx-sdk.properties) -->
        <untar src="${nbfx.release.src}" dest="${nbfx.verify.dir}/src" compression="gzip"/>
        <nbfx-verify-files dir="${nbfx.verify.dir}/src/${nbfx.release.name}" files="LICENSE,NOTICE,THIRDPARTY,KEYS" count="4"/>
        <nbfx-rat dir="${nbfx.verify.dir}/src/${nbfx.release.name}" report="rat-release-src"/>
        <fail message="The source release must not contain compiled code (jars, native libraries, class files)">
            <condition>
                <resourcecount when="greater" count="0">
                    <fileset dir="${nbfx.verify.dir}/src" includes="**/*.jar,**/*.class,**/*.dll,**/*.dylib,**/*.so,**/*.exe"/>
                </resourcecount>
            </condition>
        </fail>
        <!-- the binary: licence files present, including the JavaFX licence; no javafx.web -->
        <unzip src="${nbfx.release.bin}" dest="${nbfx.verify.dir}/bin"/>
        <nbfx-verify-files dir="${nbfx.verify.dir}/bin/${nbfx.release.name}"
                           files="LICENSE,NOTICE,THIRDPARTY,KEYS,nbfx-platform/legal/javafx/LICENSE" count="5"/>
        <loadfile property="nbfx.verify.bin.license" srcFile="${nbfx.verify.dir}/bin/${nbfx.release.name}/LICENSE"/>
        <fail message="The binary LICENSE does not mention OpenJFX">
            <condition><not><contains string="${nbfx.verify.bin.license}" substring="OpenJFX"/></not></condition>
        </fail>
        <!-- no javafx.web / WebKit in the bundle (Appendix G) -->
        <fail message="javafx.web must not be bundled">
            <condition>
                <resourcecount when="greater" count="0">
                    <fileset dir="${nbfx.verify.dir}/bin" includes="**/javafx.web*.jar,**/*jfxwebkit*"/>
                </resourcecount>
            </condition>
        </fail>
        <delete dir="${nbfx.verify.dir}/bin"/>
        <!-- every platform's natives, glass toolkit and launcher, and the merged javafx.graphics.jar
             against the pinned SDKs (downloaded here, so the check does not trust the build) -->
        <nbfx-javafx-universal dir="${nbfx.verify.dir}/javafx"/>
        <java sourcefile="${basedir}/release/tools/CheckBinary.java" fork="true" failonerror="true">
            <arg file="${nbfx.release.bin}"/>
            <arg value="${nbfx.release.name}"/>
            <arg file="${nbfx.verify.dir}/javafx/macos-aarch64/nbfx-platform/modules/ext/javafx.graphics.jar"/>
            <arg file="${nbfx.verify.dir}/javafx/macos-x64/nbfx-platform/modules/ext/javafx.graphics.jar"/>
            <arg file="${nbfx.verify.dir}/javafx/windows-x64/nbfx-platform/modules/ext/javafx.graphics.jar"/>
            <arg file="${nbfx.verify.dir}/javafx/linux-x64/nbfx-platform/modules/ext/javafx.graphics.jar"/>
        </java>
        <echo message="[nbfx] release artefacts verified: signatures, checksums, licence files, Rat, platforms"/>
    </target>

    <!-- fails unless all @{count} comma-separated @{files} exist under @{dir} -->
    <macrodef name="nbfx-verify-files">
        <attribute name="dir"/>
        <attribute name="files"/>
        <attribute name="count"/>
        <sequential>
            <fail message="@{dir} must contain all of: @{files}">
                <condition>
                    <resourcecount when="ne" count="@{count}">
                        <fileset dir="@{dir}" includes="@{files}"/>
                    </resourcecount>
                </condition>
            </fail>
        </sequential>
    </macrodef>

    <target name="release" depends="release-src,release-bin,release-sign,release-verify"
            description="Build, sign and verify the release artefacts (-Dnbfx.rc=rc1 -Dnbfx.gpg.key=...)"/>

</project>
