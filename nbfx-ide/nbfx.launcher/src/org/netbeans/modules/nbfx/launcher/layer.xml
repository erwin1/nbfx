<!DOCTYPE filesystem PUBLIC "-//NetBeans//DTD Filesystem 1.2//EN" "https://netbeans.org/dtds/filesystem-1_2.dtd">
<!--
    Masks for layer entries of the Swing window system, which is not in the nbfx clusters
    (core.windows, see docs/MVP.md 21.2). The keymap shadows of ide/defaults for Go to Recent
    Document compute their originalFile by calling RecentViewListAction.getStringRep4Unixes, so
    NbKeymap logs a ClassNotFoundException for each of them at start-up; the other shadows of that
    layer that point at core.windows actions only dangle, silently. This module depends on
    org.netbeans.modules.defaults so that its layer is ordered above that one and the masks apply.
-->
<filesystem>
    <folder name="Keymaps">
        <folder name="Emacs">
            <file name="D-BACK_QUOTE.shadow_hidden"/>
        </folder>
        <folder name="NetBeans">
            <file name="D-BACK_QUOTE.shadow_hidden"/>
        </folder>
        <folder name="NetBeans55">
            <file name="D-BACK_QUOTE.shadow_hidden"/>
        </folder>
    </folder>
</filesystem>
